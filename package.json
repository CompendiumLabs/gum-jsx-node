{
  "name": "@gum-jsx/node",
  "version": "1.8.0",
  "description": "Node runtime for gum.jsx: PNG rasterization and terminal output",
  "type": "module",
  "author": "Douglas Hanley",
  "homepage": "https://github.com/CompendiumLabs/gum-jsx-node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompendiumLabs/gum-jsx-node.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "scripts",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.ts"
    },
    "./render": {
      "types": "./types/render.d.ts",
      "import": "./src/render.ts"
    },
    "./term": {
      "types": "./types/term.d.ts",
      "import": "./src/term.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "bun ./scripts/bench.ts",
    "typecheck": "bun tsc --noEmit",
    "types": "rm -rf types && bun tsc -p tsconfig.types.json",
    "prepublishOnly": "bun run types"
  },
  "peerDependencies": {
    "@gum-jsx/core": "^1.8.0"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@gum-jsx/core": "^1.8.0",
    "@gum-jsx/docs": "^1.8.0",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}
