  },
  "peerDependenciesMeta": {
    "@gum-jsx/core": {
      "optional": true
    }
  },
  "dependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@gum-jsx/core": "link:@gum-jsx/core",
    "@gum-jsx/docs": "link:@gum-jsx/docs",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3"
  }
}
